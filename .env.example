# Copy to .env.local and fill in.
#
# ROOT SECRETS: deployment-level only, never editable from the admin. Back them up
# separately from database backups (encrypted settings are useless without the key).
# Generate each with: openssl rand -base64 32
SETTINGS_ENCRYPTION_KEY=
# Optional, during key rotation only: the previous key, so stored secrets can be re-encrypted.
SETTINGS_ENCRYPTION_KEY_PREVIOUS=
AUTH_SECRET=
# development | staging | production
APP_ENV=development
#
# Everything below is an optional fallback: once configured in Admin -> Settings, the admin values win.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
DATABASE_URL=postgresql://clothin:change-me@localhost:5432/clothin?schema=public
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Admin media storage. "local" (default) writes to STORAGE_LOCAL_DIR (default .data/uploads) and serves /media/*.
# "s3" uses any S3-compatible bucket (AWS S3, Cloudflare R2, MinIO).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
