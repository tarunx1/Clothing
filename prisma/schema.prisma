generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Currency {
  INR
  CAD
  USD
}

enum ProductImageType {
  FRONT
  BACK
  DETAIL
  MODEL
  LIFESTYLE
  OTHER
}

enum CartStatus {
  ACTIVE
  CHECKED_OUT
  ABANDONED
}

enum CheckoutStatus {
  OPEN
  VALIDATED
  CONVERTED
  EXPIRED
}

enum OrderStatus {
  DRAFT
  AWAITING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
  PAYMENT_FAILED
  EXPIRED
}

enum ReservationStatus {
  NONE
  RESERVED
  COMMITTED
  RELEASED
}

enum AdminRole {
  ADMIN
  MANAGER
  STAFF
}

enum SettingValueType {
  STRING
  NUMBER
  BOOLEAN
  JSON
  SECRET
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum InventoryAdjustmentReason {
  RESTOCK
  CORRECTION
  RETURN
  DAMAGED
  OTHER
}

enum PaymentStatus {
  CREATED
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
}

model Collection {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  slug             String            @unique
  shortDescription String            @map("short_description")
  description      String
  order            Int               @default(0)
  enabled          Boolean           @default(true)
  featured         Boolean           @default(false)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  images           CollectionImage[]
  products         Product[]

  @@index([enabled, order])
  @@map("collections")
}

model CollectionImage {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collectionId String     @map("collection_id") @db.Uuid
  src          String
  alt          String
  order        Int        @default(0)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([collectionId, order])
  @@index([collectionId])
  @@map("collection_images")
}

model Product {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  slug         String            @unique
  subtitle     String?
  description  String
  details      String?
  basePrice    BigInt            @map("base_price")
  currency     Currency
  collectionId String            @map("collection_id") @db.Uuid
  material     String?
  gsm          Int?
  fit          String?
  fitNotes     String[]          @default([]) @map("fit_notes")
  fitAdvice    String?           @map("fit_advice")
  print        String?
  care         String[]          @default([])
  sizeChart    String?           @map("size_chart")
  model3dUrl   String?           @map("model3d_url")
  featured     Boolean           @default(false)
  enabled      Boolean           @default(true)
  releaseOrder Int               @default(0) @map("release_order")
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  collection   Collection        @relation(fields: [collectionId], references: [id], onDelete: Restrict)
  images       ProductImage[]
  variants     ProductVariant[]
  orderItems   OrderItem[]
  relatedFrom  ProductRelation[] @relation("RelatedFrom")
  relatedTo    ProductRelation[] @relation("RelatedTo")

  @@index([collectionId])
  @@index([enabled, featured, releaseOrder])
  @@index([collectionId, enabled])
  @@map("products")
}

model ProductRelation {
  productId        String  @map("product_id") @db.Uuid
  relatedProductId String  @map("related_product_id") @db.Uuid
  order            Int     @default(0)
  product          Product @relation("RelatedFrom", fields: [productId], references: [id], onDelete: Cascade)
  relatedProduct   Product @relation("RelatedTo", fields: [relatedProductId], references: [id], onDelete: Cascade)

  @@id([productId, relatedProductId])
  @@index([productId, order])
  @@index([relatedProductId])
  @@map("product_relations")
}

model Color {
  id       String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name     String
  slug     String           @unique
  hex      String?
  enabled  Boolean          @default(true)
  images   ProductImage[]
  variants ProductVariant[]

  @@index([enabled, name])
  @@map("colors")
}

model Size {
  id       String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name     String
  slug     String           @unique
  order    Int              @default(0)
  enabled  Boolean          @default(true)
  variants ProductVariant[]

  @@index([enabled, order])
  @@map("sizes")
}

model ProductImage {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String           @map("product_id") @db.Uuid
  colorId   String?          @map("color_id") @db.Uuid
  src       String
  alt       String
  type      ProductImageType @default(OTHER)
  order     Int              @default(0)
  focalX    Float?           @map("focal_x")
  focalY    Float?           @map("focal_y")
  zoom      Float?
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  product   Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  color     Color?           @relation(fields: [colorId], references: [id], onDelete: SetNull)

  @@unique([productId, order, colorId])
  @@index([productId])
  @@index([colorId])
  @@map("product_images")
}

model ProductVariant {
  id             String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId      String                @map("product_id") @db.Uuid
  colorId        String                @map("color_id") @db.Uuid
  sizeId         String                @map("size_id") @db.Uuid
  sku            String                @unique
  price          BigInt?
  compareAtPrice BigInt?               @map("compare_at_price")
  enabled        Boolean               @default(true)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  product        Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  color          Color                 @relation(fields: [colorId], references: [id], onDelete: Restrict)
  size           Size                  @relation(fields: [sizeId], references: [id], onDelete: Restrict)
  inventory      Inventory?
  cartItems      CartItem[]
  orderItems     OrderItem[]
  adjustments    InventoryAdjustment[]

  @@unique([productId, colorId, sizeId])
  @@index([productId])
  @@index([colorId])
  @@index([sizeId])
  @@index([productId, enabled])
  @@map("product_variants")
}

model Inventory {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  variantId        String         @unique @map("variant_id") @db.Uuid
  quantity         Int            @default(0)
  reservedQuantity Int            @default(0) @map("reserved_quantity")
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  variant          ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId])
  @@map("inventory")
}

model Cart {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId String?         @unique @map("session_id")
  userId    String?         @map("user_id") @db.Uuid
  status    CartStatus      @default(ACTIVE)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  items     CartItem[]
  checkouts CheckoutDraft[]

  @@index([userId, status])
  @@index([status, updatedAt])
  @@map("carts")
}

model CartItem {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cartId    String         @map("cart_id") @db.Uuid
  variantId String         @map("variant_id") @db.Uuid
  quantity  Int
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([cartId, variantId])
  @@index([cartId])
  @@index([variantId])
  @@map("cart_items")
}

model DeliveryMethod {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code             String          @unique
  name             String
  description      String
  price            BigInt
  currency         Currency
  enabled          Boolean         @default(true)
  estimatedMinDays Int             @map("estimated_min_days")
  estimatedMaxDays Int             @map("estimated_max_days")
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  checkouts        CheckoutDraft[]

  @@index([enabled, name])
  @@map("delivery_methods")
}

model CheckoutDraft {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cartId           String           @map("cart_id") @db.Uuid
  email            String
  deliveryMethodId String           @map("delivery_method_id") @db.Uuid
  status           CheckoutStatus   @default(OPEN)
  subtotal         BigInt
  shippingAmount   BigInt           @map("shipping_amount")
  taxAmount        BigInt           @default(0) @map("tax_amount")
  total            BigInt
  currency         Currency
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  cart             Cart             @relation(fields: [cartId], references: [id], onDelete: Restrict)
  deliveryMethod   DeliveryMethod   @relation(fields: [deliveryMethodId], references: [id], onDelete: Restrict)
  shippingAddress  ShippingAddress?
  order            Order?

  @@index([cartId, status])
  @@index([deliveryMethodId])
  @@map("checkout_drafts")
}

model ShippingAddress {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  checkoutDraftId String?        @unique @map("checkout_draft_id") @db.Uuid
  orderId         String?        @unique @map("order_id") @db.Uuid
  firstName       String         @map("first_name")
  lastName        String         @map("last_name")
  address1        String
  address2        String?
  city            String
  region          String
  postalCode      String         @map("postal_code")
  countryCode     String         @map("country_code") @db.Char(2)
  company         String?
  phone           String?
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  checkoutDraft   CheckoutDraft? @relation(fields: [checkoutDraftId], references: [id], onDelete: Cascade)
  order           Order?         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([checkoutDraftId])
  @@index([orderId])
  @@map("shipping_addresses")
}

model Order {
  id                   String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  checkoutDraftId      String            @unique @map("checkout_draft_id") @db.Uuid
  orderNumber          String            @unique @map("order_number")
  email                String
  status               OrderStatus       @default(AWAITING_PAYMENT)
  currency             Currency
  subtotal             BigInt
  shippingAmount       BigInt            @map("shipping_amount")
  taxAmount            BigInt            @default(0) @map("tax_amount")
  discountAmount       BigInt            @default(0) @map("discount_amount")
  total                BigInt
  /// Opaque, cryptographically random token for customer-facing order access.
  publicToken          String            @unique @map("public_token")
  reservationStatus    ReservationStatus @default(NONE) @map("reservation_status")
  reservationExpiresAt DateTime?         @map("reservation_expires_at") @db.Timestamptz(3)
  paidAt               DateTime?         @map("paid_at") @db.Timestamptz(3)
  confirmationSentAt   DateTime?         @map("confirmation_sent_at") @db.Timestamptz(3)
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  checkoutDraft        CheckoutDraft     @relation(fields: [checkoutDraftId], references: [id], onDelete: Restrict)
  items                OrderItem[]
  shippingAddress      ShippingAddress?
  payments             Payment[]
  shipment             Shipment?

  @@index([status, createdAt])
  @@index([reservationStatus, reservationExpiresAt])
  @@index([email, createdAt])
  @@map("orders")
}

model OrderItem {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId     String          @map("order_id") @db.Uuid
  productId   String?         @map("product_id") @db.Uuid
  variantId   String?         @map("variant_id") @db.Uuid
  productName String          @map("product_name")
  sku         String
  sizeName    String          @map("size_name")
  colorName   String          @map("color_name")
  unitPrice   BigInt          @map("unit_price")
  quantity    Int
  lineTotal   BigInt          @map("line_total")
  imageUrl    String?         @map("image_url")
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@map("order_items")
}

model Payment {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId           String        @map("order_id") @db.Uuid
  provider          String
  providerOrderId   String        @unique @map("provider_order_id")
  providerPaymentId String?       @unique @map("provider_payment_id")
  providerSignature String?       @map("provider_signature")
  /// "test" or "live": the credential set used, so test and live payments never cross.
  mode              String?
  amount            BigInt
  currency          Currency
  status            PaymentStatus @default(CREATED)
  failureCode       String?       @map("failure_code")
  failureMessage    String?       @map("failure_message")
  succeededAt       DateTime?     @map("succeeded_at") @db.Timestamptz(3)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, status])
  @@map("payments")
}

/// Provider webhook delivery log. Stores identifiers only, never raw payloads.
model WebhookEvent {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider    String
  eventId     String    @map("event_id")
  eventType   String    @map("event_type")
  processedAt DateTime? @map("processed_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([provider, eventId])
  @@index([createdAt])
  @@map("webhook_events")
}

model AdminUser {
  id           String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String                @unique
  name         String
  /// scrypt hash (see lib/admin/password.ts). Never selected into responses.
  passwordHash String                @map("password_hash")
  role         AdminRole             @default(STAFF)
  active       Boolean               @default(true)
  lastLoginAt  DateTime?             @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions     AdminSession[]
  auditLogs    AdminAuditLog[]
  adjustments  InventoryAdjustment[]

  @@map("admin_users")
}

/// Server-side admin session. The cookie holds a random token; only its SHA-256 hash is stored.
model AdminSession {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  adminId    String    @map("admin_id") @db.Uuid
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  lastUsedAt DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  /// Last password confirmation (sign-in or step-up). Sensitive changes require it to be recent.
  stepUpAt   DateTime? @map("step_up_at") @db.Timestamptz(3)
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  admin      AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([expiresAt])
  @@map("admin_sessions")
}

/// Stock is changed by recorded deltas, never by blind overwrites.
model InventoryAdjustment {
  id             String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  variantId      String                    @map("variant_id") @db.Uuid
  quantityDelta  Int                       @map("quantity_delta")
  quantityBefore Int                       @map("quantity_before")
  quantityAfter  Int                       @map("quantity_after")
  reason         InventoryAdjustmentReason
  note           String?
  adminId        String?                   @map("admin_id") @db.Uuid
  createdAt      DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  variant        ProductVariant            @relation(fields: [variantId], references: [id], onDelete: Cascade)
  admin          AdminUser?                @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([variantId, createdAt])
  @@index([createdAt])
  @@map("inventory_adjustments")
}

model AdminAuditLog {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminId    String?    @map("admin_id") @db.Uuid
  action     String
  entityType String     @map("entity_type")
  entityId   String?    @map("entity_id")
  /// Small, non-sensitive change summary. Never passwords, tokens or payment credentials.
  metadata   Json?
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  admin      AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entityType, entityId])
  @@map("admin_audit_logs")
}

model Shipment {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId        String    @unique @map("order_id") @db.Uuid
  carrier        String?
  trackingNumber String?   @map("tracking_number")
  trackingUrl    String?   @map("tracking_url")
  shippedAt      DateTime? @map("shipped_at") @db.Timestamptz(3)
  deliveredAt    DateTime? @map("delivered_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("shipments")
}

/// Presentation copy for known storefront slots (hero, brand story, newsletter, settings).
/// Each value is validated by a Zod schema in lib/content. Commerce data stays relational.
model SiteContent {
  key         String   @id
  value       Json
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("site_content")
}

model LookbookImage {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  src        String
  alt        String
  lane       Int
  order      Int      @default(0)
  enabled    Boolean  @default(true)
  position   String?
  creditName String?  @map("credit_name")
  creditUrl  String?  @map("credit_url")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([enabled, lane, order])
  @@map("lookbook_images")
}

/// Typed store configuration. Non-secret values live in `value`; secrets are
/// AES-256-GCM encrypted (ciphertext/iv/authTag) and never stored in plaintext.
model SystemSetting {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  namespace         String
  key               String
  value             Json?
  valueType         SettingValueType @map("value_type")
  isSecret          Boolean          @default(false) @map("is_secret")
  encrypted         Boolean          @default(false)
  ciphertext        String?
  iv                String?
  authTag           String?          @map("auth_tag")
  keyId             String?          @map("key_id")
  encryptionVersion Int?             @map("encryption_version")
  /// Last characters of a secret for recognition (e.g. ••••4F8A). Absent for short secrets.
  secretHint        String?          @map("secret_hint")
  description       String?
  updatedById       String?          @map("updated_by_id") @db.Uuid
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([namespace, key])
  @@index([namespace])
  @@map("system_settings")
}

/// Settings history. Secret changes record only that they happened, never values.
model SettingChange {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  namespace     String
  key           String
  action        String
  previousValue Json?    @map("previous_value")
  newValue      Json?    @map("new_value")
  adminId       String?  @map("admin_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([namespace, createdAt])
  @@index([createdAt])
  @@map("setting_changes")
}

model WebhookEndpoint {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  url              String
  events           String[]
  enabled          Boolean           @default(true)
  secretCiphertext String            @map("secret_ciphertext")
  secretIv         String            @map("secret_iv")
  secretAuthTag    String            @map("secret_auth_tag")
  secretKeyId      String            @map("secret_key_id")
  secretHint       String?           @map("secret_hint")
  createdById      String?           @map("created_by_id") @db.Uuid
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  deliveries       WebhookDelivery[]

  @@map("webhook_endpoints")
}

/// Outbound delivery log: event, status and timing only. Payloads are not stored.
model WebhookDelivery {
  id          String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  endpointId  String                @map("endpoint_id") @db.Uuid
  event       String
  eventId     String                @map("event_id")
  status      WebhookDeliveryStatus @default(PENDING)
  httpStatus  Int?                  @map("http_status")
  attempts    Int                   @default(0)
  error       String?
  durationMs  Int?                  @map("duration_ms")
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt DateTime?             @map("completed_at") @db.Timestamptz(3)
  endpoint    WebhookEndpoint       @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([endpointId, createdAt])
  @@index([createdAt])
  @@map("webhook_deliveries")
}

/// Keys for external apps calling this store. Only a SHA-256 hash is stored.
model ApiKey {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  prefix      String    @unique
  keyHash     String    @unique @map("key_hash")
  permissions String[]
  createdById String?   @map("created_by_id") @db.Uuid
  lastUsedAt  DateTime? @map("last_used_at") @db.Timestamptz(3)
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("api_keys")
}

/// Advanced: credentials for services without a built-in integration. Secret is encrypted.
model CustomCredential {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  label            String
  service          String
  endpoint         String?
  publicKey        String?  @map("public_key")
  secretCiphertext String?  @map("secret_ciphertext")
  secretIv         String?  @map("secret_iv")
  secretAuthTag    String?  @map("secret_auth_tag")
  secretKeyId      String?  @map("secret_key_id")
  secretHint       String?  @map("secret_hint")
  createdById      String?  @map("created_by_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("custom_credentials")
}

/// Last connection test per integration. Errors are short, sanitized messages.
model IntegrationHealth {
  id           String   @id
  status       String
  environment  String?
  lastTestedAt DateTime @map("last_tested_at") @db.Timestamptz(3)
  lastError    String?  @map("last_error")
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("integration_health")
}

model NewsletterSubscriber {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String   @unique
  source    String   @default("homepage")
  status    String   @default("SUBSCRIBED")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("newsletter_subscribers")
}
